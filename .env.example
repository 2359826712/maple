# Local development uses /api through Vite. Hosted builds default to the
# Supabase maplehub-api Edge Function when this value is omitted.
VITE_MAPLE_SQL_API_BASE_URL=/api
VITE_MAPLE_SQL_TENANT_KEY=default
VITE_GOOGLE_CLIENT_ID=146017234212-3rlmu2u16hmdru86a6pjjog6sr0cr9a5.apps.googleusercontent.com

# Vite dev proxy target for the Go backend in D:/Desktop/maple_sql/backend.
MAPLE_SQL_API_ORIGIN=http://127.0.0.1:8080
VITE_ENABLE_ANALYTICS=false
VITE_ANALYTICS_ENDPOINT=/api/telemetry/events
VITE_INTERNAL_SESSION=false

# Website SSR should use a read-only PostgreSQL role through this server-only
# variable. It must not contain Worker/service-role credentials.
CONTENT_READ_DATABASE_URL=postgresql://content_reader.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?uselibpqcompat=true&sslmode=require

# Worker and migration processes use this separate server-only connection.
# Do not expose either value with a NEXT_PUBLIC_ or VITE_ prefix.
LOCALIZATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?uselibpqcompat=true&sslmode=require

# Phase 2E website adapter. Mock is the safe default. OpenAI-compatible mode is
# preview-only while LocalizationWorker-repair.exe owns production queue work.
LOCAL_MODEL_PROVIDER=local
LOCAL_MODEL_TRANSPORT=mock
LOCAL_MODEL_API_URL=
LOCAL_MODEL_API_KEY=
MODEL_NAME=
MODEL_VERSION=
LOCAL_MODEL_TIMEOUT_MS=120000
LOCAL_MODEL_PUBLISHABLE=false
